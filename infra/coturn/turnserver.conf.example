# Supply a real public hostname/IP and a randomly generated shared secret.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
realm=turn.your-domain.example
server-name=turn.your-domain.example
external-ip=REPLACE_WITH_PUBLIC_IP
min-port=49160
max-port=49200
no-cli
no-loopback-peers
no-multicast-peers
# Enable TLS with your certificate before advertising turns: URLs.
# cert=/etc/coturn/tls/fullchain.pem
# pkey=/etc/coturn/tls/privkey.pem
