# Copy to apps/web/.env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Set these in Supabase Edge Function secrets, NOT NEXT_PUBLIC variables:
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
# Future optional integration only. No direct OpenAI calls are implemented.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
